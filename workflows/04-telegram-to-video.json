    {
      "parameters": {
        "jsCode": "const https = require('https');\nconst prev = $('Code: Извлечь asset ID').first().json;\n\nconst body = JSON.stringify({\n  video_inputs: [{\n    character: {type: 'avatar', avatar_id: '715aa2df861d4321ac0556f8b1488c17', avatar_style: 'normal'},\n    voice: {type: 'audio', audio_asset_id: prev.audioAssetId},\n    background: {type: 'color', value: '#1a1a2e'}\n  }],\n  dimension: {width: 1080, height: 1920},\n  caption: false,\n  test: false\n});\n\nconst data = await new Promise((resolve, reject) => {\n  const req = https.request({\n    hostname: 'api.heygen.com',\n    path: '/v2/video/generate',\n    method: 'POST',\n    headers: {\n      'X-Api-Key': 'sk_V2_hgu_kETTuZnvTzy_DqRxB09L6kDYDkl2wlxBN2T2ejSrkeld',\n      'Content-Type': 'application/json',\n      'Content-Length': Buffer.byteLength(body)\n    }\n  }, (res) => {\n    let raw = '';\n    res.on('data', chunk => raw += chunk);\n    res.on('end', () => { try { resolve(JSON.parse(raw)); } catch(e) { reject(e); } });\n  });\n  req.on('error', reject);\n  req.write(body);\n  req.end();\n});\nif (data?.error) {\n  throw new Error('HeyGen: ' + (data.error?.message || JSON.stringify(data.error)));\n}\nreturn [{ json: { ...prev, heygenResponse: data } }];"
      },
