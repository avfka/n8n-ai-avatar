      "id": "60cc9344-c6e9-4a06-9dd7-2eb26bfad505",
      "name": "Telegram Trigger",
      "type": "n8n-nodes-base.telegramTrigger",
      "typeVersion": 1.1,
      "position": [
        9856,
        5152
      ],
      "webhookId": "ai-avatar-telegram-trigger",
      "credentials": {
        "telegramApi": {
          "id": "UYU2INDj1AkN4VRb",
          "name": "Telegram account"
        }
      },
      "notes": "Получает любое сообщение. Токен бота — в Telegram API credential."
    },
    {
      "parameters": {
        "jsCode": "const msg = $input.first().json.message;\nconst chatId = msg?.chat?.id?.toString();\nconst text = (msg?.text || '').trim();\nconst userId = msg?.from?.id?.toString();\n\nif (!chatId || !text) return [];\n\nconst state = $getWorkflowStaticData('global');\nconst userState = state[chatId] || { step: 'idle' };\n\nlet action = 'unknown';\nlet payload = {};\n\nif (text === '/start') {\n  action = 'start';\n  state[chatId] = { step: 'idle' };\n} else if (text === '/cancel') {\n  action = 'cancel';\n  state[chatId] = { step: 'idle' };\n} else if (userState.step === 'idle') {\n  if (text.length < 20) {\n    action = 'too_short';\n  } else if (text.length > 2000) {\n    action = 'too_long';\n    payload.length = text.length;\n  } else {\n    action = 'new_script';\n    payload.script = text;\n  }\n} else if (userState.step === 'waiting_approval') {\n  const lower = text.toLowerCase();\n  if (lower === 'да' || lower === 'ok' || lower === 'ок' || lower === 'го' || lower === '👍') {\n    action = 'approved';\n    payload.polishedScript = userState.polishedScript;\n  } else {\n    action = 'revision';\n    payload.originalScript = userState.originalScript;\n    payload.polishedScript = userState.polishedScript;\n    payload.feedback = text;\n  }\n} else if (userState.step === 'waiting_new_video') {\n  const lower = text.toLowerCase();\n  if (lower === 'да' || lower === 'yes' || lower === '👍') {\n    action = 'want_new';\n    state[chatId] = { step: 'idle' };\n  } else if (lower === 'нет' || lower === 'no' || lower === '👎') {\n    action = 'no_new';\n    state[chatId] = { step: 'idle' };\n  } else {\n    action = 'unexpected_new_video';\n  }\n} else {\n  action = 'unexpected';\n}\nreturn [{ json: { action, chatId, userId, text, payload, userState, isInit: action === 'start' || action === 'cancel' } }];"
      },
