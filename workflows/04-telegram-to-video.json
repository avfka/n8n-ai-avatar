        "jsCode": "const statusResp = $input.first().json;\nconst prev = $('Code: Извлечь video ID').first().json;\nconst pollCount = ($input.first().json.pollCount || 0) + 1;\nconst status = statusResp?.data?.status || statusResp?.status;\nconst videoUrl = statusResp?.data?.video_url || statusResp?.video_url || null;\nconst thumbnailUrl = statusResp?.data?.thumbnail_url || null;\nif (status === 'failed') throw new Error('HeyGen рендер завершился ошибкой: ' + JSON.stringify(statusResp));\nif (pollCount > 24) throw new Error(`HeyGen не завершил рендер за 12 минут (${pollCount} попыток). Проверьте видео вручную: ${prev.videoId}`);\nreturn [{ json: { ...prev, status, videoUrl, thumbnailUrl, checkedAt: new Date().toISOString(), pollCount } }];"
