      "parameters": {
        "jsCode": "const statusResp = $input.first().json;\nconst prev = $('Code: Извлечь video ID').first().json;\nconst status = statusResp?.data?.status || statusResp?.status;\nconst videoUrl = statusResp?.data?.video_url || statusResp?.video_url || null;\nconst thumbnailUrl = statusResp?.data?.thumbnail_url || null;\nif (status === 'failed') throw new Error('HeyGen рендер завершился ошибкой: ' + JSON.stringify(statusResp));\nreturn [{ json: { ...prev, status, videoUrl, thumbnailUrl, checkedAt: new Date().toISOString() } }];"
      },
