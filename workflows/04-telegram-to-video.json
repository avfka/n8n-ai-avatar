    {
      "parameters": {
        "jsCode": "const audioData = $input.first().binary?.data;\nconst prev = $('Code: Запустить рендер').first().json;\nif (!audioData) throw new Error('ElevenLabs не вернул аудио');\nreturn [{ json: { ...prev, audioMimeType: audioData.mimeType || 'audio/mpeg' }, binary: { data: audioData } }];"
      },
