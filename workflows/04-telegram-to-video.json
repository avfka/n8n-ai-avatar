    {
      "parameters": {
        "jsCode": "const resp = $input.first().json;\nconst prev = $('Code: Запустить рендер').first().json;\nif (resp.error) throw new Error('HeyGen error: ' + JSON.stringify(resp.error));\nconst videoId = resp?.data?.video_id || resp?.video_id;\nif (!videoId) throw new Error('video_id не получен: ' + JSON.stringify(resp));\nreturn [{ json: { ...prev, videoId, startedAt: new Date().toISOString() } }];"
      },
