{
  "name": "04 – Telegram Script → GPT Polish → ElevenLabs → HeyGen Video",
  "nodes": [
    {
      "parameters": {
        "updates": ["message"],
        "additionalFields": {}
      },
      "id": "tg-01",
      "name": "Telegram Trigger",
      "type": "n8n-nodes-base.telegramTrigger",
      "typeVersion": 1.1,
      "position": [0, 300],
      "webhookId": "ai-avatar-telegram-trigger",
      "notes": "Получает любое сообщение. Токен бота — в Telegram API credential."
    },
    {
      "parameters": {
        "jsCode": "const msg = $input.first().json.message;\nconst chatId = msg?.chat?.id?.toString();\nconst text = (msg?.text || '').trim();\nconst userId = msg?.from?.id?.toString();\n\nif (!chatId || !text) return [];\n\n// Читаем состояние из staticData\nconst state = $getWorkflowStaticData('global');\nconst userState = state[chatId] || { step: 'idle' };\n\nlet action = 'unknown';\nlet payload = {};\n\nif (text === '/start') {\n  action = 'start';\n} else if (text === '/cancel') {\n  action = 'cancel';\n} else if (userState.step === 'idle') {\n  // Новый черновик сценария\n  if (text.length < 20) {\n    action = 'too_short';\n  } else if (text.length > 2000) {\n    action = 'too_long';\n    payload.length = text.length;\n  } else {\n    action = 'new_script';\n    payload.script = text;\n  }\n} else if (userState.step === 'waiting_approval') {\n  const lower = text.toLowerCase();\n  if (lower === 'ок' || lower === 'ok' || lower === 'да' || lower === 'го' || lower === '👍') {\n    action = 'approved';\n    payload.polishedScript = userState.polishedScript;\n  } else {\n    // Пользователь прислал правки\n    action = 'revision';\n    payload.originalScript = userState.originalScript;\n    payload.polishedScript = userState.polishedScript;\n    payload.feedback = text;\n  }\n} else {\n  action = 'unexpected';\n}\n\nreturn [{\n  json: {\n    action,\n    chatId,\n    userId,\n    text,\n    payload,\n    userState\n  }\n}];"
      },
